# Copy this file to .env and fill in your Supabase project values
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth client id for web (Google Cloud Console)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google OAuth client ids for native builds (Google Cloud Console)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Groq API key (Whisper transcription)
EXPO_PUBLIC_GROQ_API_KEY=

# Gemini API key (AI vector search embeddings)
EXPO_PUBLIC_GEMINI_API_KEY=

# Optional: override embedding model (default: gemini-embedding-001)
EXPO_PUBLIC_GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional: override intent model for Smart Search (default: gemini-2.5-flash)
EXPO_PUBLIC_GEMINI_INTENT_MODEL=gemini-2.5-flash
