{
  "expo": {
    "name": "ExploreEaseExpo",
    "slug": "ExploreEaseExpo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-vlu.png",
    "scheme": "exploreeaseexpo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ExploreEase cần vị trí của bạn để tìm địa danh gần đây."
      }
    },
    "android": {
      "permissions": [
        "POST_NOTIFICATIONS",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo-vlu.png",
        "monochromeImage": "./assets/images/logo-vlu.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.ExploreEaseExpo"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo-vlu.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "ExploreEase cần truy cập thư viện ảnh để bạn đính kèm ảnh vào đánh giá.",
          "cameraPermission": "ExploreEase cần truy cập camera để bạn chụp ảnh cho đánh giá."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
